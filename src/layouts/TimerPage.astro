---
import '@/styles/timer.css';
import Base from './Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Faq from '@/components/Faq.astro';
import Related from '@/components/Related.astro';
import Timer from '@/islands/Timer';
import Stopwatch from '@/islands/Stopwatch';
import type { ModeConfig } from '@/engine/schedule';
import type { Faq as FaqItem } from '@/data/types';
import { softwareApplication, faqPage, breadcrumbList, crumbsFor } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  /** one or two sentences under the H1, server rendered */
  lede: string;
  config: ModeConfig;
  fixed?: boolean | undefined;
  presets?: boolean | undefined;
  faq?: FaqItem[] | undefined;
  related: string[];
  posts?: string[] | undefined;
  crumbName?: string | undefined;
  jsonLd?: Record<string, unknown>[] | undefined;
}
const {
  title,
  description,
  path,
  h1,
  lede,
  config,
  fixed = false,
  presets = false,
  faq = [],
  related,
  posts = [],
  crumbName,
  jsonLd = [],
} = Astro.props;

const crumbs = path === '/' ? [] : crumbsFor(path, crumbName ?? h1);
const ld = [
  softwareApplication(h1, path, description),
  ...(faq.length ? [faqPage(faq)] : []),
  ...(crumbs.length ? [breadcrumbList(crumbs)] : []),
  ...jsonLd,
];
---

<Base {title} {description} {path} jsonLd={ld}>
  {crumbs.length > 0 && <Breadcrumbs {crumbs} />}
  <main id="main" class="wrap">
    <header class="tp-head">
      <h1>{h1}</h1>
      <p class="tp-lede">{lede}</p>
    </header>

    {config.mode === 'stopwatch' ? (
      <Stopwatch client:load />
    ) : (
      <Timer client:load config={config} {fixed} {presets} />
    )}

    <noscript>
      <p class="tp-noscript">The timer needs JavaScript. Everything below reads fine without it.</p>
    </noscript>

    <slot />

    {faq.length > 0 && <Faq items={faq} />}
    <Related timers={related} posts={posts} />
  </main>
</Base>

<style>
  .tp-head {
    padding-block: var(--sp-5) var(--sp-2);
  }
  .tp-head h1 {
    margin-bottom: var(--sp-2);
  }
  .tp-lede {
    color: var(--grey-700);
    font-size: var(--fs-3);
    margin: 0;
  }
  .tp-noscript {
    text-align: center;
    color: var(--grey-700);
    padding: var(--sp-6);
    border: 1px dashed var(--grey-300);
  }
</style>
