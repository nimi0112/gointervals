---
import '@/styles/timer.css';
import Base from './Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Faq from '@/components/Faq.astro';
import Related from '@/components/Related.astro';
import Timer from '@/islands/Timer';
import type { ModeConfig } from '@/engine/schedule';
import type { Faq as FaqItem } from '@/data/types';
import { softwareApplication, faqPage, breadcrumbList, crumbsFor } from '@/lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  /** one or two sentences under the H1, server rendered in the guide */
  lede: string;
  config: ModeConfig;
  fixed?: boolean | undefined;
  faq?: FaqItem[] | undefined;
  related: string[];
  posts?: string[] | undefined;
  crumbName?: string | undefined;
  jsonLd?: Record<string, unknown>[] | undefined;
}
const {
  title,
  description,
  path,
  h1,
  lede,
  config,
  fixed = false,
  faq = [],
  related,
  posts = [],
  crumbName,
  jsonLd = [],
} = Astro.props;

const crumbs = crumbsFor(path, crumbName ?? h1);
const ld = [
  softwareApplication(h1, path, description),
  ...(faq.length ? [faqPage(faq)] : []),
  breadcrumbList(crumbs),
  ...jsonLd,
];
---

<Base {title} {description} {path} jsonLd={ld} header={false}>
  <main id="main" class="wrap">
    <Timer client:load config={config} {fixed} />

    <noscript>
      <p class="tp-noscript">The timer needs JavaScript. Everything below reads fine without it.</p>
    </noscript>

    <div class="guide">
      <Breadcrumbs {crumbs} />
      <header class="guide__head">
        <h1>{h1}</h1>
        <p class="guide__lede">{lede}</p>
      </header>
      <slot />
      {faq.length > 0 && <Faq items={faq} />}
      <Related timers={related} posts={posts} />
    </div>
  </main>
</Base>
