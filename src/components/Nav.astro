---
import { TIMERS } from '@/lib/site';
const current = Astro.url.pathname;
---

<header class="nav wrap">
  <a class="nav__brand" href="/" aria-label="Go Intervals home">
    <span class="nav__mark" aria-hidden="true"></span>
    Go Intervals
  </a>
  <nav aria-label="Timers">
    <ul class="nav__list">
      {TIMERS.map((t) => (
        <li>
          <a href={t.path} aria-current={current === t.path ? 'page' : undefined}>
            {t.short}
          </a>
        </li>
      ))}
      <li>
        <a href="/blog" aria-current={current.startsWith('/blog') ? 'page' : undefined}>
          Blog
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    flex-wrap: wrap;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
    font-size: var(--fs-3);
  }
  .nav__mark {
    width: 10px;
    height: 10px;
    background: var(--accent);
    border-radius: 50%;
  }
  .nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--sp-1);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    max-width: 100%;
  }
  .nav__list::-webkit-scrollbar {
    display: none;
  }
  .nav__list a {
    display: inline-block;
    padding: 10px var(--sp-3);
    min-height: 44px;
    text-decoration: none;
    color: var(--grey-700);
    font-size: var(--fs-1);
    font-weight: 500;
    white-space: nowrap;
    border-radius: var(--radius);
  }
  .nav__list a:hover {
    color: var(--ink);
    background: var(--grey-100);
  }
  .nav__list a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  @media (max-width: 719px) {
    .nav {
      padding-block: var(--sp-3);
    }
    .nav nav {
      flex-basis: 100%;
      margin-inline: calc(-1 * var(--sp-4));
      padding-inline: var(--sp-4);
      mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
    }
  }
</style>
