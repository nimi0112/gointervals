---
import type { CollectionEntry } from 'astro:content';
import { readingTime } from '@/lib/readingTime';

interface Props {
  posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<ul class="posts">
  {posts.map((p) => {
    const rt = readingTime(p.body ?? '');
    return (
      <li class="posts__item">
        <p class="posts__meta num">
          <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time> · {rt.minutes}{' '}
          min read
        </p>
        <h2 class="posts__title">
          <a href={`/blog/${p.id}`}>{p.data.title}</a>
        </h2>
        <p class="posts__desc">{p.data.description}</p>
        <ul class="links posts__tags">
          {p.data.tags.map((t) => (
            <li>
              <a href={`/blog/tag/${t}`}>{t}</a>
            </li>
          ))}
        </ul>
      </li>
    );
  })}
</ul>

<style>
  .posts {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: var(--measure);
  }
  .posts__item {
    padding-block: var(--sp-5);
    border-top: 1px solid var(--line);
  }
  .posts__meta {
    color: var(--muted);
    font-size: var(--fs-label);
    margin-bottom: var(--sp-2);
  }
  .posts__title {
    font-size: var(--fs-section);
    margin-bottom: var(--sp-2);
  }
  .posts__desc {
    color: var(--muted);
    margin-bottom: var(--sp-2);
  }
  .posts__tags {
    font-size: var(--fs-small);
  }
</style>
