---
import type { Faq } from '@/data/types';
interface Props {
  items: Faq[];
  title?: string;
}
const { items, title = 'Common questions' } = Astro.props;
---

<section class="section" id="faq">
  <h2>{title}</h2>
  <div class="faq">
    {items.map((f) => (
      <div class="faq__item">
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    max-width: var(--measure);
  }
  .faq__item h3 {
    margin-bottom: var(--sp-2);
  }
  .faq__item p {
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
  }
</style>
