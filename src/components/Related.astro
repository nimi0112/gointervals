---
import { getCollection } from 'astro:content';
import { TIMERS } from '@/lib/site';
import { timerPages } from '@/data';

interface Props {
  timers: string[];
  posts?: string[];
}
const { timers, posts = [] } = Astro.props;

const nameFor = (path: string): string =>
  TIMERS.find((t) => t.path === path)?.name ?? timerPages.find((p) => p.path === path)?.h1 ?? path;

const blog = posts.length ? await getCollection('blog', (p) => !p.data.draft) : [];
const postItems = posts
  .map((path) => blog.find((p) => `/blog/${p.id}` === path))
  .filter((p): p is NonNullable<typeof p> => !!p);
---

<section class="section">
  <h2>Related</h2>
  <div class="related">
    <div>
      <h3>Timers</h3>
      <ul class="links">
        {timers.map((path) => (
          <li>
            <a href={path}>{nameFor(path)}</a>
          </li>
        ))}
      </ul>
    </div>
    {postItems.length > 0 && (
      <div>
        <h3>Reading</h3>
        <ul class="links">
          {postItems.map((p) => (
            <li>
              <a href={`/blog/${p.id}`}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .related {
    display: grid;
    gap: var(--sp-5);
  }
  @media (min-width: 720px) {
    .related {
      grid-template-columns: 1fr 1fr;
    }
  }
  h3 {
    color: var(--muted);
    font-size: var(--fs-small);
    margin-bottom: var(--sp-2);
  }
  .links {
    flex-direction: column;
    gap: 0;
  }
</style>
