---
import TimerPage from '@/layouts/TimerPage.astro';
import Section from '@/components/Section.astro';
import type { ProgrammaticPage } from '@/data/types';
import { configSeconds } from '@/engine/schedule';
import { describeConfig } from '@/engine/describe';
import { howTo } from '@/lib/seo';

interface Props {
  page: ProgrammaticPage;
  posts?: string[];
}
const { page, posts = [] } = Astro.props;
const setup = describeConfig(page.config);
const total = configSeconds(page.config);
---

<TimerPage
  title={page.title}
  description={page.description}
  path={page.path}
  h1={page.h1}
  lede={setup}
  config={page.config}
  fixed
  presets={page.config.mode === 'interval'}
  faq={page.faq}
  related={page.related.filter((r) => !r.startsWith('/blog/'))}
  posts={[...page.related.filter((r) => r.startsWith('/blog/')), ...posts]}
  crumbName={page.h1}
  jsonLd={[howTo(page.h1, page.path, setup, total)]}
>
  <Section num="01" title="What this one is for" flush>
    {page.intro.map((p) => (
      <p>{p}</p>
    ))}
  </Section>
  <Section num="02" title="Good for">
    <ul>
      {page.uses.map((u) => (
        <li>{u}</li>
      ))}
    </ul>
  </Section>
  <Section num="03" title="How it runs">
    <p>
      {setup} Press Start, or hit Space. The digits turn green while a work block runs and grey on
      rest.
    </p>
    {page.config.mode === 'meditation' ? (
      <p>
        The only sound is one soft bell: at the start, at each interval, and at the end. No ticks
        before it. Mute with the speaker button for a silent sit. The screen stays on while the
        timer runs.
      </p>
    ) : (
      <p>
        Sound is on by default: a rising pair for work, a falling pair for rest, a tick for the last
        three seconds and a three-note finish. Mute with the speaker button. The screen stays on
        while the timer runs and the tab title shows the time left.
      </p>
    )}
    <p>
      Change anything in Settings under the timer. The last setup you used on this page is
      remembered in your browser.
    </p>
  </Section>
</TimerPage>
