---
import TimerPage from '@/layouts/TimerPage.astro';
import Section from '@/components/Section.astro';
import type { ProgrammaticPage } from '@/data/types';
import { configSeconds } from '@/engine/schedule';
import { describeConfig } from '@/engine/describe';
import { howTo } from '@/lib/seo';

interface Props {
  page: ProgrammaticPage;
  posts?: string[];
}
const { page, posts = [] } = Astro.props;
const setup = describeConfig(page.config);
const total = configSeconds(page.config);
const med = page.config.mode === 'meditation';
const pomo = page.config.mode === 'pomodoro';
const fixedTabata = page.config.mode === 'tabata';
---

<TimerPage
  title={page.title}
  description={page.description}
  path={page.path}
  h1={page.h1}
  lede={setup}
  config={page.config}
  fixed
  faq={page.faq}
  related={page.related.filter((r) => !r.startsWith('/blog/'))}
  posts={[...page.related.filter((r) => r.startsWith('/blog/')), ...posts]}
  crumbName={page.h1}
  jsonLd={[howTo(page.h1, page.path, setup, total, fixedTabata)]}
>
  <Section title="What this one is for" flush>
    {page.intro.map((p) => (
      <p>{p}</p>
    ))}
  </Section>
  {page.uses?.length ? (
    <Section title="Good for">
      <ul>
        {page.uses.map((u) => (
          <li>{u}</li>
        ))}
      </ul>
    </Section>
  ) : null}
  <Section title="How it runs">
    <p>
      {setup} Press Start, or hit Space. The phase word and icon above the progress bar tell you
      where you are.
    </p>
    {med ? (
      <p>
        Start, interval and end bells have independent switches. Only enabled bells play; interval
        bells do not restart the session clock. Sound off mutes audio, though supported devices may
        still vibrate.
      </p>
    ) : (
      <p>
        Check the Sound chip and device volume before starting. Work and rest have different tones.
        The tab title shows the time left. Start begins the first phase immediately; prepare your
        space first.
      </p>
    )}
    <p>
      Keep the page visible for cues. The timer requests an awake screen, but the browser can refuse
      it or delay background sound. For offline use, load this exact page online and test a reload
      without a connection before relying on it.
    </p>
    <p>
      {fixedTabata
        ? 'This page uses fixed 20/10 timing for eight rounds. Choose a variant to edit the durations.'
        : `Change the settings before starting. ${med || pomo ? 'Durations use minutes.' : 'Work and Rest use seconds on this page.'} This page opens with its preset each visit; the main timer page remembers your valid settings.`}
    </p>
  </Section>
</TimerPage>
