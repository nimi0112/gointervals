---
import TimerPage from '@/layouts/TimerPage.astro';
import Section from '@/components/Section.astro';
import type { ProgrammaticPage } from '@/data/types';
import { configSeconds } from '@/engine/schedule';
import { describeConfig } from '@/engine/describe';
import { howTo } from '@/lib/seo';

interface Props {
  page: ProgrammaticPage;
  posts?: string[];
}
const { page, posts = [] } = Astro.props;
const setup = describeConfig(page.config);
const total = configSeconds(page.config);
const med = page.config.mode === 'meditation';
---

<TimerPage
  title={page.title}
  description={page.description}
  path={page.path}
  h1={page.h1}
  lede={setup}
  config={page.config}
  fixed
  faq={page.faq}
  related={page.related.filter((r) => !r.startsWith('/blog/'))}
  posts={[...page.related.filter((r) => r.startsWith('/blog/')), ...posts]}
  crumbName={page.h1}
  jsonLd={[howTo(page.h1, page.path, setup, total)]}
>
  <Section title="What this one is for" flush>
    {page.intro.map((p) => (
      <p>{p}</p>
    ))}
  </Section>
  <Section title="Good for">
    <ul>
      {page.uses.map((u) => (
        <li>{u}</li>
      ))}
    </ul>
  </Section>
  <Section title="How it runs">
    <p>{setup} Press Start, or hit Space. The phase word and icon above the progress bar tell you where you are.</p>
    {med ? (
      <p>
        The only sound is one soft bell at each interval and one at the end, and each of those is a
        switch you can turn off. Sound On/Off under the timer silences everything. The screen stays
        on while the session runs.
      </p>
    ) : (
      <p>
        Sound is on by default and needs a tap on Start to unlock: a rising pair for work, a
        falling pair for rest, a tick through the last three seconds and a three-note finish. The
        screen stays on while the timer runs and the tab title shows the time left.
      </p>
    )}
    <p>
      Change the numbers above the Start button before you begin. This page always opens with the
      preset shown here; the main {med ? 'meditation' : 'timer'} page remembers your own settings.
    </p>
  </Section>
</TimerPage>
