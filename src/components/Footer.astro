---
/** Footer navigation is Timers / About only, by design. It follows all content. */
---

<footer class="ftr">
  <nav class="wrap ftr__inner" aria-label="Footer">
    <a href="/">Timers</a>
    <a href="/about">About</a>
  </nav>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--line);
    margin-top: var(--sp-8);
  }
  .ftr__inner {
    display: flex;
    gap: var(--sp-4);
    padding-block: var(--sp-5);
  }
  .ftr a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--sp-4);
    font-size: var(--fs-ui);
  }
</style>
