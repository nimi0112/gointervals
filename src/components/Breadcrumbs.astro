---
import type { Crumb } from '@/lib/seo';
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav class="crumbs wrap" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i < crumbs.length - 1 ? (
          <a href={c.path}>{c.name}</a>
        ) : (
          <span aria-current="page">{c.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs {
    font-size: var(--fs-1);
    color: var(--grey-500);
    padding-block: var(--sp-2);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }
  li + li::before {
    content: '/';
    margin-right: var(--sp-2);
    color: var(--grey-300);
  }
  a {
    text-decoration: none;
    color: var(--grey-700);
  }
  a:hover {
    text-decoration: underline;
  }
</style>
