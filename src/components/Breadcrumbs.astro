---
import type { Crumb } from '@/lib/seo';
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {crumbs.map((c, i) => (
      <li>
        {i < crumbs.length - 1 ? (
          <a href={c.path}>{c.name}</a>
        ) : (
          <span aria-current="page">{c.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs {
    font-size: var(--fs-small);
    color: var(--muted);
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
  }
  li + li::before {
    content: '/';
    margin-right: var(--sp-2);
    color: var(--line);
  }
  a {
    display: inline-block;
    padding-block: 10px;
    color: var(--ink);
  }
  span {
    font-size: 0.75rem;
  }
</style>
