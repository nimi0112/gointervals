---
import TimerPage from '@/layouts/TimerPage.astro';
import Section from '@/components/Section.astro';
import { faqs } from '@/data/faqs';
import { relatedTimers, relatedPosts } from '@/data/related';
import { defaultConfigs } from '@/engine/presets';
import { beeps } from '@/data/beeps';
import { workouts } from '@/data/workouts';
---

<TimerPage
  title="Interval Timer – Free Work, Rest and Rounds Timer"
  description="Free online interval timer for HIIT, circuits and repeating reminders. Set work, rest and rounds, get a beep at every change. No login, works offline."
  path="/interval"
  h1="Interval timer"
  lede="Work, rest, rounds. A beep at every change so you can put the phone down and get on with it."
  config={defaultConfigs.interval}
  faq={faqs['/interval']}
  related={relatedTimers['/interval']!}
  posts={relatedPosts['/interval']}
  crumbName="Interval timer"
>
  <Section title="Set it up" flush>
    <p>
      Work is the hard bit, Rest is the easy bit, Rounds is how many times you repeat the pair. Type
      a number or tap − and +. Start goes straight into the first work block; the rest after the
      last round is included, so the session ends on a breath rather than a sprint.
    </p>
    <p>
      Set Rest to 0 for a timer that just beeps every N minutes. Thirty minute blocks, eight rounds,
      and you have a four hour timer with a beep every half hour. That is the default.
    </p>
  </Section>
  <Section title="Run it">
    <p>
      Press Start or hit Space. Work shows a pulse icon, Rest shows a breath. The sounds are
      different too: a rising pair to go, a falling pair to stop, a tick for the last three seconds,
      a three-note finish. Pause keeps the clock exactly where it was.
    </p>
    <p>
      Esc or End session asks before it stops anything. The timer holds a screen wake lock while it
      runs, so the phone does not go dark halfway through round six, and the tab title counts down
      when the page is in the background on a desktop.
    </p>
  </Section>
  <Section title="Ready-made">
    <p>Named workouts and repeating beeps, each on its own page with the timer already set.</p>
    <ul class="links">
      {workouts.map((w) => (
        <li>
          <a href={w.path}>{w.h1}</a>
        </li>
      ))}
      {beeps.map((b) => (
        <li>
          <a href={b.path}>{b.h1}</a>
        </li>
      ))}
    </ul>
  </Section>
</TimerPage>
