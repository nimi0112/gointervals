---
import Base from '@/layouts/Base.astro';
import { breadcrumbList, person } from '@/lib/seo';
import { SITE } from '@/lib/site';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
];
---

<Base
  title="About gointervals"
  description="A free online timer for movement, focus and quiet moments, built by Nimish Nandwana. No accounts, no ads, open source, works offline after the first visit."
  path="/about"
  jsonLd={[breadcrumbList(crumbs), person()]}
>
  <main id="main" class="wrap about">
    <h1>A little room for your time.</h1>
    <p>
      gointervals is a free online timer for movement, focus and quiet moments. Pick Interval,
      Tabata, EMOM, Pomodoro or Meditation. Set your time and settle in.
    </p>
    <p>
      No accounts. No ads. No cookies of our own; only anonymous usage stats so I can see which
      timers get used. After your first visit, it works offline once your browser has saved the app.
    </p>
    <p>
      Built by Nimish Nandwana. The code is open source. You can read it, suggest a change, or make
      it your own.
    </p>
    <ul class="about__links">
      <li>
        <a href={SITE.repo} rel="noopener">
          Source on GitHub
        </a>
      </li>
      <li>
        <a href={SITE.authorUrl} rel="noopener author">
          Nimish Nandwana
        </a>
      </li>
      <li>
        <a href={SITE.authorX} rel="noopener">
          Nimish on X
        </a>
      </li>
    </ul>
    <section class="about__feedback" aria-labelledby="feedback-heading">
      <h2 id="feedback-heading">Feedback</h2>
      <p>Something not working, or an idea to share? Send Nimish a note.</p>
      <a class="about__email" href="mailto:nimishnandwana@gmail.com?subject=gointervals%20feedback">
        nimishnandwana@gmail.com
      </a>
      <p class="about__hint">
        Opens your email app. For a bug, include the timer, device and what happened.
      </p>
    </section>
    <p class="about__data">
      Your settings stay in this browser.
      <button type="button" class="btn btn--quiet about__clear" id="clear-data">
        Clear my data
      </button>
      <span id="clear-status" role="status"></span>
    </p>
  </main>

  <script>
    const btn = document.getElementById('clear-data');
    const status = document.getElementById('clear-status');
    btn?.addEventListener('click', () => {
      try {
        const keys: string[] = [];
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && k.startsWith('gi:')) keys.push(k);
        }
        keys.forEach((k) => localStorage.removeItem(k));
        if (status)
          status.textContent = `Cleared ${keys.length} item${keys.length === 1 ? '' : 's'}.`;
      } catch {
        if (status) status.textContent = 'Nothing to clear, or storage is blocked.';
      }
    });
  </script>
</Base>

<style>
  /* Canvas 375: content pad 32/0, gap 24, heading 36/500/1.15, paragraphs 16/1.5 muted,
     links 44 high pad 4/16. Canvas 1280: content pad 64/240, heading 48. Footer 32 below. */
  .about {
    flex: 1;
    padding-block: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }
  .about h1 {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0;
  }
  .about p {
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
    max-width: none;
  }
  .about__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .about__links a {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding: var(--sp-1) var(--sp-4);
  }
  /* Canvas: feedback block pads 24 above, gap 12, T3 heading 22/500/1.3, helper 13/1.5 muted.
     The address is the same 44-high accent-underlined link as the list above; it may wrap
     at narrow widths or high zoom rather than overflow. */
  .about__feedback {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
    padding-top: var(--sp-5);
  }
  .about__feedback h2 {
    margin: 0;
    font-size: var(--fs-section);
    font-weight: 500;
    line-height: 1.3;
  }
  .about__email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    max-width: 100%;
    padding: var(--sp-1) var(--sp-4);
    overflow-wrap: anywhere;
  }
  .about__hint {
    font-size: var(--fs-label);
  }
  .about__data {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
    font-size: var(--fs-small);
  }
  .about__clear {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    padding-inline: var(--sp-3);
  }
  #clear-status {
    font-size: var(--fs-label);
  }
  @media (min-width: 720px) {
    .about {
      padding-block: var(--sp-8);
      padding-inline: calc(var(--gutter) + 240px);
    }
    .about h1 {
      font-size: 3rem;
    }
  }
</style>
