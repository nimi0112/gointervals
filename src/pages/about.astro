---
import Base from '@/layouts/Base.astro';
import { breadcrumbList, person } from '@/lib/seo';
import { SITE } from '@/lib/site';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
];
---

<Base
  title="About gointervals"
  description="A free online timer for movement, focus and quiet moments, built by Nimish Nandwana. No accounts, no ads, open source, works offline after the first visit."
  path="/about"
  jsonLd={[breadcrumbList(crumbs), person()]}
>
  <main id="main" class="wrap about">
    <h1>A little room for your time.</h1>
    <p>
      gointervals is a free online timer for movement, focus and quiet moments. Pick Interval,
      Tabata, EMOM, Pomodoro or Meditation. Set your time and settle in.
    </p>
    <p>
      No accounts. No ads. No cookies of our own; only anonymous usage stats so I can see which
      timers get used. After your first visit, it works offline once your browser has saved the
      app.
    </p>
    <p>
      Built by Nimish Nandwana. The code is open source. You can read it, suggest a change, or
      make it your own.
    </p>
    <ul class="about__links">
      <li><a href={SITE.repo} rel="noopener">Source on GitHub</a></li>
      <li><a href={SITE.authorUrl} rel="noopener author">Nimish Nandwana</a></li>
      <li><a href={SITE.authorX} rel="noopener">Nimish on X</a></li>
    </ul>
    <p class="about__data">
      Your settings stay in this browser.
      <button type="button" class="btn btn--quiet about__clear" id="clear-data">Clear my data</button>
      <span id="clear-status" role="status"></span>
    </p>
  </main>

  <script>
    const btn = document.getElementById('clear-data');
    const status = document.getElementById('clear-status');
    btn?.addEventListener('click', () => {
      try {
        const keys: string[] = [];
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && k.startsWith('gi:')) keys.push(k);
        }
        keys.forEach((k) => localStorage.removeItem(k));
        if (status) status.textContent = `Cleared ${keys.length} item${keys.length === 1 ? '' : 's'}.`;
      } catch {
        if (status) status.textContent = 'Nothing to clear, or storage is blocked.';
      }
    });
  </script>
</Base>

<style>
  .about {
    padding-block: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    max-width: calc(var(--measure) + 2 * var(--gutter));
  }
  .about h1 {
    margin: 0;
    line-height: 1.15;
  }
  .about p {
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
  }
  .about__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .about__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--sp-4);
  }
  .about__data {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-3);
    font-size: var(--fs-small);
  }
  .about__clear {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    padding-inline: var(--sp-3);
  }
  #clear-status {
    font-size: var(--fs-label);
  }
</style>
