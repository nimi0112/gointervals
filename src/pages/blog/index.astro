---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import PostList from '@/components/PostList.astro';
import { getCollection } from 'astro:content';
import { breadcrumbList } from '@/lib/seo';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog' },
];
---

<Base
  title="Blog – Timers, Intervals and Focus, Explained"
  description="Short, specific guides to interval bells, Tabata, HIIT, EMOM, Pomodoro and keeping your phone awake during a workout, by the person who built the timers."
  path="/blog"
  jsonLd={[breadcrumbList(crumbs)]}
>
  <main id="main" class="wrap">
    <header class="bh">
      <Breadcrumbs {crumbs} />
      <h1>Blog</h1>
      <p class="bh__lede">How the protocols work and how to run them with a timer. No fluff intros.</p>
      <ul class="links bh__tags" aria-label="Tags">
        {tags.map((t) => (
          <li>
            <a href={`/blog/tag/${t}`}>{t}</a>
          </li>
        ))}
      </ul>
    </header>
    <PostList {posts} />
  </main>
</Base>

<style>
  .bh {
    padding-block: var(--sp-6) var(--sp-5);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    max-width: var(--measure);
  }
  .bh h1 {
    margin: 0;
  }
  .bh__lede {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-lead);
  }
  .bh__tags {
    font-size: var(--fs-small);
  }
</style>
