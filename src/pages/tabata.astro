---
import TimerPage from '@/layouts/TimerPage.astro';
import Section from '@/components/Section.astro';
import { faqs } from '@/data/faqs';
import { relatedTimers, relatedPosts } from '@/data/related';
import { defaultConfigs } from '@/engine/presets';
import { tabatas } from '@/data/tabatas';
---

<TimerPage
  title="Tabata Timer – Free 20/10 x 8 Timer with Beeps"
  description="Run the classic Tabata clock: 20 seconds work, 10 seconds rest and eight rounds. See how the four-minute total works and plan the rest of your session."
  path="/tabata"
  h1="Tabata timer"
  lede="This Tabata timer runs the classic pattern: 20 seconds on, 10 seconds off, 8 rounds, 4 minutes. There's nothing to set. Just press Start."
  config={defaultConfigs.tabata}
  faq={faqs['/tabata']}
  related={relatedTimers['/tabata']!}
  posts={relatedPosts['/tabata']}
  crumbName="Tabata timer"
>
  <Section title="What the four minutes include" flush>
    <p>
      Eight work periods of twenty seconds total 2:40. Eight rests of ten seconds add 1:20. The last
      effort ends at 3:50, and the final rest brings the session to 4:00.
    </p>
    <p>
      Start begins round one immediately. Preparation, warm-up and any recovery between separate
      blocks are outside this clock. The{' '}
      <a href="/blog/how-long-is-a-tabata-workout">session-duration guide</a> shows how to budget
      the whole session.
    </p>
  </Section>
  <Section title="Timing and training are different">
    <p>
      The format is associated with{' '}
      <a href="https://pubmed.ncbi.nlm.nih.gov/8897392/">
        Tabata and colleagues' 1996 cycling study
      </a>
      . That research tested a specific programme and intensity. Using the same work/rest pattern
      does not guarantee the same results.
    </p>
    <p>
      Choose activity and effort appropriate to your plan. The timer cannot assess technique or
      recovery. Read{' '}
      <a href="/blog/what-is-a-tabata-timer">what the Tabata clock does and does not tell you</a>{' '}
      for the distinction.
    </p>
  </Section>
  <Section title="Other interval patterns">
    <p>
      This page is fixed at 20/10 for eight rounds. Apart from the classic 20/10 preset, the
      variants below use editable interval settings. They are different schedules, not the original
      protocol.
    </p>
    <ul class="links">
      {tabatas.map((t) => (
        <li>
          <a href={t.path}>{t.h1}</a>
        </li>
      ))}
    </ul>
    <p>
      For whole-minute work and rest, use <a href="/interval">Interval</a>. For a planned set at
      each minute's start, use <a href="/emom">EMOM</a>.
    </p>
  </Section>
  <Section title="Check your cues">
    <p>
      A rising tone marks work, a falling tone marks rest, and ticks mark the final three seconds of
      each phase. Test your volume and keep the page visible. Background sound and an awake screen
      depend on the browser and device.
    </p>
  </Section>
</TimerPage>
