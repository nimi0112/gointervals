---
import Base from '@/layouts/Base.astro';
import Faq from '@/components/Faq.astro';
import { TIMERS, SITE } from '@/lib/site';
import { faqs } from '@/data/faqs';
import { webSite, organization, faqPage, itemList } from '@/lib/seo';
import { iconSvg } from '@/lib/icons';
import { beeps } from '@/data/beeps';
import { meditations } from '@/data/meditations';
import { tabatas } from '@/data/tabatas';
import { pomodoros } from '@/data/pomodoros';
import { workouts } from '@/data/workouts';

const faq = faqs['/']!;
const ready = [
  ...beeps.slice(0, 4),
  ...meditations.slice(1, 4),
  ...tabatas.slice(0, 3),
  ...workouts.slice(0, 3),
  ...pomodoros.slice(0, 2),
];
---

<Base
  title="Free interval, meditation, Tabata, EMOM and Pomodoro timers"
  description={SITE.description}
  path="/"
  jsonLd={[webSite(), organization(), faqPage(faq), itemList(TIMERS)]}
>
  <main id="main" class="wrap home">
    <header class="home__intro">
      <p class="home__eyebrow num">Five tools. One thing at a time.</p>
      <h1>Make time for your next thing.</h1>
      <p class="home__lede">
        A little structure for work, rest and everything in between. Choose a timer to get going.
      </p>
      <p class="home__index">
        <span class="num">01—05</span>
        <span>Pick a timer. Find your rhythm.</span>
      </p>
    </header>

    <ul class="rows home__timers" aria-label="Timers">
      {TIMERS.map((t, i) => (
        <li>
          <a class="row" href={t.path}>
            <span class="row__index">{String(i + 1).padStart(2, '0')}</span>
            <span class="row__text">
              <span class="row__name">{t.short}</span>
              <span class="row__desc">{t.blurb}</span>
            </span>
            <span class="row__icon" set:html={iconSvg('arrow-up-right', 24)} />
          </a>
        </li>
      ))}
    </ul>

    <section class="section home__guide">
      <h2>Online interval and meditation timers</h2>
      <div class="prose">
        <p>
          Use Interval to alternate exercise and recovery, Tabata for short work–rest rounds, or
          EMOM to begin a new effort each minute.
        </p>
        <p>
          For study, Pomodoro separates focused work from breaks. For meditation, periodic gentle
          beeps mark time without needing to watch the screen. Try a 30-minute session with a beep
          every 10 minutes.
        </p>
      </div>
    </section>

    <Faq items={faq} />

    <section class="section">
      <h2>Ready-made timers</h2>
      <div class="prose">
        <p>The same timers, already set for a specific job, each on its own page.</p>
      </div>
      <ul class="links">
        {ready.map((p) => (
          <li>
            <a href={p.path}>{p.h1}</a>
          </li>
        ))}
      </ul>
    </section>

    <p class="home__article">
      <a href="/blog/meditation-timer-interval-bells">Read the meditation timer guide</a>
    </p>
  </main>
</Base>

<style>
  .home {
    padding-top: var(--sp-5);
  }
  .home__intro {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: var(--sp-5);
  }
  .home__intro h1 {
    margin: 0;
  }
  .home__eyebrow {
    margin: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .home__lede {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.35;
  }
  .home__index {
    margin: var(--sp-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--muted);
    font-size: var(--fs-label);
  }
  .home__index .num {
    font-size: var(--fs-section);
    color: var(--ink);
  }
  .home__guide {
    margin-top: var(--sp-5);
  }
  .home__article {
    margin: var(--sp-4) 0 0;
  }
  .home__article a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
  }
  @media (min-width: 720px) {
    .home {
      padding-top: var(--sp-7);
    }
    .home__top {
      display: grid;
    }
    .home__lede {
      font-size: var(--fs-lead);
      max-width: 36ch;
    }
    .home__index .num {
      font-size: var(--fs-sub);
    }
  }
</style>
