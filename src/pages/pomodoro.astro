---
import TimerPage from '@/layouts/TimerPage.astro';
import Section from '@/components/Section.astro';
import { faqs } from '@/data/faqs';
import { relatedTimers, relatedPosts } from '@/data/related';
import { defaultConfigs } from '@/engine/presets';
import { pomodoros } from '@/data/pomodoros';
---

<TimerPage
  title="Pomodoro Timer – Free 25/5 Focus Timer, No Login"
  description="Free online Pomodoro timer: 25 minutes focus, 5 minute break, a 15 minute long break after four. One finite cycle, editable, tab title countdown, works offline."
  path="/pomodoro"
  h1="Pomodoro timer"
  lede="25 minutes on, 5 off, a long break after four. One finite cycle, then it stops."
  config={defaultConfigs.pomodoro}
  faq={faqs['/pomodoro']}
  related={relatedTimers['/pomodoro']!}
  posts={relatedPosts['/pomodoro']}
  crumbName="Pomodoro timer"
>
  <Section title="The technique" flush>
    <p>
      Francesco Cirillo, a tomato-shaped kitchen timer, late 1980s. Work for 25 minutes on one
      thing, take a 5 minute break, and after four of those take 15 to 30 minutes off. The numbers
      are less important than the rule that a pomodoro is indivisible: if you get interrupted, it
      does not count.
    </p>
  </Section>
  <Section title="Using this one">
    <p>
      Press Start and leave the tab open. The title shows the minutes left, so you can see it from
      another tab. A rising pair means focus, a falling pair means break. The cycle runs Focus 1,
      short break, Focus 2, short break, Focus 3, short break, Focus 4, long break, Done. It does
      not start again on its own.
    </p>
    <p>Prefer 50/10? Change Focus and Short break above the Start button. The change sticks.</p>
  </Section>
  <Section title="Other rhythms">
    <p>Preset pages for the common alternatives, each with its own reasoning.</p>
    <ul class="links">
      {pomodoros.map((p) => (
        <li>
          <a href={p.path}>{p.h1}</a>
        </li>
      ))}
    </ul>
  </Section>
</TimerPage>
