---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Page not found"
  description="That page does not exist on gointervals. The timers are all still here: interval, meditation, Tabata, EMOM and Pomodoro."
  path="/404"
  noindex
>
  <main id="main" class="wrap nf">
    <h1>This page drifted away.</h1>
    <p>
      <a href="/">Back to timers</a>
    </p>
  </main>
</Base>

<style>
  /* Canvas: content pad 32/0, gap 24, heading 36/500/1.15, link 48 high pad 4/16. */
  .nf {
    flex: 1;
    padding-block: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }
  .nf h1 {
    margin: 0;
    font-size: 2.25rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: 0;
  }
  .nf p {
    margin: 0;
  }
  .nf a {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: var(--sp-1) var(--sp-4);
    font-size: var(--fs-ui);
  }
</style>
