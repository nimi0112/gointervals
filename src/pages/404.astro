---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Page not found"
  description="That page does not exist on gointervals. The timers are all still here: interval, meditation, Tabata, EMOM and Pomodoro."
  path="/404"
  noindex
>
  <main id="main" class="wrap nf">
    <h1>This page drifted away.</h1>
    <p><a href="/">Back to timers</a></p>
  </main>
</Base>

<style>
  .nf {
    padding-block: var(--sp-6);
    min-height: 60dvh;
  }
  .nf h1 {
    margin-bottom: var(--sp-4);
  }
  .nf a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--sp-4);
    font-size: var(--fs-small);
  }
</style>
