---
import Base from '@/layouts/Base.astro';
import { TIMERS } from '@/lib/site';
---

<Base
  title="Page not found"
  description="That page does not exist on Go Intervals. The timers are all still here: stopwatch, countdown, interval, Tabata, EMOM and Pomodoro."
  path="/404"
  noindex
>
  <main id="main" class="wrap nf">
    <p class="nf__code mono">404</p>
    <h1>Nothing here</h1>
    <p class="nf__lede">The timer you wanted is probably one of these.</p>
    <ul class="list">
      {TIMERS.map((t) => (
        <li>
          <a href={t.path}>
            <span class="list__title">{t.name}</span>
            <span class="list__meta">{t.path}</span>
          </a>
        </li>
      ))}
      <li>
        <a href="/blog">
          <span class="list__title">Blog</span>
          <span class="list__meta">/blog</span>
        </a>
      </li>
    </ul>
  </main>
</Base>

<style>
  .nf {
    padding-block: var(--sp-7);
    max-width: var(--measure);
  }
  .nf__code {
    color: var(--accent);
    margin-bottom: var(--sp-2);
  }
  .nf__lede {
    color: var(--grey-700);
    margin-bottom: var(--sp-6);
  }
</style>
