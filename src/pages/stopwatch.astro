---
import TimerPage from '@/layouts/TimerPage.astro';
import Section from '@/components/Section.astro';
import { faqs } from '@/data/faqs';
import { relatedTimers, relatedPosts } from '@/data/related';
---

<TimerPage
  title="Online Stopwatch – Free Stopwatch with Laps and Splits"
  description="Free online stopwatch with lap times, split and total per lap, fastest and slowest marked. Keyboard shortcuts, fullscreen, no login, works offline."
  path="/stopwatch"
  h1="Stopwatch"
  lede="Start, lap, pause, reset. Splits and totals for every lap, fastest and slowest marked."
  config={{ mode: 'stopwatch' }}
  faq={faqs['/stopwatch']}
  related={relatedTimers['/stopwatch']!}
  posts={relatedPosts['/stopwatch']}
  crumbName="Stopwatch"
>
  <Section num="01" title="Laps" flush>
    <p>
      Press Lap or L each time something happens: a runner passes, a set ends, a lap of the pool.
      Each lap shows its own split and the running total. The fastest split is marked in green, the
      slowest in grey, once there are at least two.
    </p>
  </Section>
  <Section num="02" title="Accuracy">
    <p>
      The display refreshes at a tenth of a second but every lap is recorded to the millisecond from
      the system clock. Background the tab for an hour and the total is still right. Reaction time
      on the button is the only error you need to worry about, which is roughly 0.2 seconds for most
      people.
    </p>
  </Section>
</TimerPage>
