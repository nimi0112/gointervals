{
  "name": "gointervals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free browser timers: stopwatch, countdown, interval/HIIT, Tabata, EMOM, Pomodoro. No login.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/stamp-sw.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:build": "node scripts/check-build.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "deploy": "npm run build && npx --yes wrangler pages deploy dist --project-name gointervals",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.2",
    "preact": "^10.29.8",
    "satori": "^0.33.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.7.0",
    "node-html-parser": "^9.0.4",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nimi0112/gointervals.git"
  },
  "homepage": "https://gointervals.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nimi0112/gointervals/issues"
  }
}
