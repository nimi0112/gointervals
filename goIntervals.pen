        {
          "type": "frame",
          "id": "mT3RL",
          "name": "02 / Implementation and rationale",
          "width": "fill_container",
          "gap": 30,
          "children": [
            {
              "type": "frame",
              "id": "N88Oxz",
              "name": "Interaction contract",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "UZloq",
                  "name": "Title",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Interaction contract",
                  "lineHeight": 1.4,
                  "fontFamily": "$sans",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "X13Dd",
                  "name": "Body",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Whole timer rows open setup; never auto-start. Enter activates links; Space activates buttons. Chip uses aria-pressed. Interval: ±1 second work/rest; ±1 round. Meditation: ±1 minute session/bell interval. Values are directly editable; limits live in each timer’s behavior notes. Other timer increments remain undefined until designed. Focus each stepper control separately. Disabled means announced unavailable and blocked activation. Progress is not a tab stop.",
                  "lineHeight": 1.4,
                  "fontFamily": "$sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Ud0EO",
              "name": "Why this system",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 10,
              "children": [
                {
                  "type": "text",
                  "id": "e8cUR",
                  "name": "Title",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Why this system",
                  "lineHeight": 1.4,
                  "fontFamily": "$sans",
                  "fontSize": 18,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "Z3DIOz",
                  "name": "Body",
                  "fill": "$muted",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A timer should feel dependable, not busy. Porcelain surfaces and one forest accent keep the UI restrained. Dark text and visible focus preserve clarity. Five broad rows help people choose, with Meditation immediately after Interval. Useful guidance sits below selection. Numeral and material studies are review options, not a change to the timer UX.",
                  "lineHeight": 1.4,
                  "fontFamily": "$sans",
                  "fontSize": 14,
                  "fontWeight": "normal"
                }
              ]
            },
