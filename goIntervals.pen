            {
              "type": "text",
              "id": "d0aWyH",
              "name": "Inputs and controls body",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Session and interval use ±1 minute. Session: 1–180 minutes; interval: 1 minute through session length. Interval Off disables that field but retains its value. Start and end chips are independent. Preview plays one sample. Digits stay visible: one quiet glance should be enough without needing to touch the screen.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "k1n3j",
          "name": "Pause, sound and reliability",
