                    {
                      "type": "frame",
                      "id": "CtWFc",
                      "name": "Link target · Open the meditation timer",
                      "height": 44,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "frame",
                          "id": "JgU1C",
