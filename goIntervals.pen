              "name": "Pause, sound and reliability heading",
              "fill": "$ink",
              "content": "Pause, sound and reliability",
              "fontFamily": "$sans",
              "fontSize": 18,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "ICDzb",
              "name": "Pause, sound and reliability body",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Pause freezes both clocks and silences scheduled bells. Resume uses the remaining active time. Sound On/Off is explicit. Do not replay missed bells in a burst after returning to the tab. No flashing or decorative animation at a bell; phase and clock changes remain readable with reduced motion.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
