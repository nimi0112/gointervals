              "fontFamily": "$sans",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "gXeqw",
          "name": "30 minutes. A bell every 10.",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "jFkft",
              "name": "30 minutes. A bell every 10. heading",
              "fill": "$ink",
              "content": "30 minutes. A bell every 10.",
              "fontFamily": "$sans",
              "fontSize": 18,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "zCwiq",
              "name": "30 minutes. A bell every 10. body",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "With interval bells On: soft cues at elapsed 10:00 and 20:00. With end bell On: one completion cue at 30:00, never two simultaneous cues. Interval, start and end bells are independently optional. Default start bell Off, interval On, end On. Global mute overrides all cues.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "K6a3t5",
          "name": "Inputs and controls",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "o1IB8",
              "name": "Inputs and controls heading",
              "fill": "$ink",
              "content": "Inputs and controls",
              "fontFamily": "$sans",
              "fontSize": 18,
