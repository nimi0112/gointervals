            },
            {
              "type": "text",
              "id": "cw4x3",
              "name": "Meditation / interval bells body",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "One clock shows the time left in the whole session. A quieter line shows time until the next bell. The interval bell does not restart the session or turn meditation into work/rest rounds.",
