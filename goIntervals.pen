          "children": [
            {
              "type": "text",
              "id": "B9uzdl",
              "name": "H2 · Online interval and meditation timers",
              "context": "h2",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Online interval and meditation timers",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 22,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "Q8tnLN",
              "name": "Exercise guidance",
              "context": "p",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Use Interval to alternate exercise and recovery, Tabata for short work–rest rounds, or EMOM to begin a new effort each minute.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "XqMK8",
              "name": "Study and meditation guidance",
              "context": "p",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "For study, Pomodoro separates focused work from breaks. For meditation, periodic gentle beeps mark time without needing to watch the screen. Try a 30-minute session with a beep every 10 minutes.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 15,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "p2ffb",
