            {
              "type": "text",
              "id": "EDy6m",
              "name": "Exercise guidance",
              "context": "p",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Use Interval to alternate exercise and recovery, Tabata for short work–rest rounds, or EMOM to begin a new effort each minute.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "qKHU8",
              "name": "Study and meditation guidance",
              "context": "p",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "For study, Pomodoro separates focused work from breaks. For meditation, periodic gentle beeps mark time without needing to watch the screen. Try a 30-minute session with a beep every 10 minutes.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 16,
              "fontWeight": "normal"
            },
            {
              "type": "text",
              "id": "frTUK",
              "name": "H2 · Common questions",
              "context": "h2",
              "fill": "$ink",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Common questions",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 22,
              "fontWeight": "normal"
            },
            {
              "type": "frame",
              "id": "Qd6Jl",
              "name": "FAQ answers",
              "width": "fill_container",
              "layout": "vertical",
              "gap": 18,
              "children": [
                {
                  "type": "frame",
                  "id": "yegQI",
                  "name": "What are meditation interval bells?",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 6,
                  "children": [
                    {
                      "type": "text",
                      "id": "rn1Or",
                      "name": "H3 · What are meditation interval bells?",
                      "context": "h3",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What are meditation interval bells?",
                      "lineHeight": 1.5,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "m623Tu",
                      "name": "Answer",
                      "context": "p",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "They are brief sound cues at regular points during a session. In a 30-minute session, a gentle beep every 10 minutes marks the intervals so you can return attention to your breath.",
                      "lineHeight": 1.5,
                      "fontFamily": "$sans",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "HSAzu",
                  "name": "Can I use the timers offline?",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 6,
                  "children": [
                    {
                      "type": "text",
                      "id": "qofve",
                      "name": "H3 · Can I use the timers offline?",
                      "context": "h3",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Can I use the timers offline?",
                      "lineHeight": 1.5,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "xjnFj",
                      "name": "Answer",
                      "context": "p",
                      "fill": "$muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "After the first online visit, timers can work offline once the app has been cached by your browser. Clearing site data removes that cache; visit online again before relying on offline use.",
                      "lineHeight": 1.5,
                      "fontFamily": "$sans",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
            },
