              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "JCqYF",
              "name": "Before implementation body",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Use an audio context unlocked by Start or Preview. Offline works after the first load. Request screen wake lock while running where supported. Mobile browsers may suspend sound in the background or with the phone locked; do not promise background alarms. Keep explanatory search content on the home page, away from the active timer.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
