                        },
                        {
                          "type": "frame",
                          "id": "MrUB8",
                          "name": "Link target · Nimish Nandwana",
                          "height": 44,
                          "alignItems": "center",
                          "children": [
                            {
                              "type": "frame",
                              "id": "FLwpY",
                              "name": "Persistent underline",
                              "stroke": "$ink",
                              "strokeWidth": {
                                "bottom": 1
