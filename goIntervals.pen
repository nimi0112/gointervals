    {
      "type": "frame",
      "id": "lTG23",
      "x": 2335,
      "y": 4180,
      "name": "Interval · Interaction contract",
      "width": 1280,
      "fill": "$paper",
      "layout": "vertical",
      "gap": 24,
      "padding": 48,
      "children": [
        {
          "type": "frame",
          "id": "Sjy2o",
          "name": "Interval / behavior",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "Bl4Rb",
              "name": "Interval / behavior",
              "fill": "$ink",
              "content": "Interval / behavior",
              "fontFamily": "$sans",
              "fontSize": 28,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "rQRLv",
              "name": "Interval / behavior notes",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "The clock always comes first. Navigation sits below the controls on both widths. Work and rest use words and different symbols, not a colour swap. The clock uses monospaced tabular numerals; reserve its width in code.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "BA34p",
          "name": "Configure",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "zKUbX",
              "name": "Configure",
              "fill": "$ink",
              "content": "Configure",
              "fontFamily": "$sans",
              "fontSize": 18,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "b44UV",
              "name": "Configure notes",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Tap the number to type using the numeric keyboard. Tap − or + for one second or one round. Hold to repeat after 400 ms. Work: 1–3,600 seconds. Rest: 0–3,600 seconds. Rounds: 1–99. Clamp at limits and disable the relevant stepper. Announce invalid input inline.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "vRChI",
          "name": "Run and finish",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "vOINP",
              "name": "Run and finish",
              "fill": "$ink",
              "content": "Run and finish",
              "fontFamily": "$sans",
              "fontSize": 18,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "RoSum",
              "name": "Run and finish notes",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Start enters Work immediately. Pause preserves the clock and phase. End session uses the shared confirmation state. Run again starts the same settings; Change settings returns to setup. These samples include the final rest.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
          "id": "oN8RA",
          "name": "Implementation and accessibility",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "kejUq",
              "name": "Implementation and accessibility",
              "fill": "$ink",
              "content": "Implementation and accessibility",
              "fontFamily": "$sans",
              "fontSize": 18,
              "fontWeight": "500"
            },
            {
              "type": "text",
              "id": "xkX5m",
              "name": "Implementation and accessibility notes",
              "fill": "$muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Use a monotonic deadline, not decrement-only intervals. Keep wake lock while active when supported; reacquire on return. Cache the app for offline use after the first visit. Beeps require a start gesture. Announce phases and completion, never every second. Keyboard focus follows the system focus rule.",
              "lineHeight": 1.5,
              "fontFamily": "$sans",
              "fontSize": 16,
              "fontWeight": "normal"
            }
          ]
        },
        {
          "type": "frame",
