                      ]
                    },
                    {
                      "type": "frame",
                      "id": "KDfQP",
                      "name": "Link target · Open the meditation timer",
                      "height": 44,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "frame",
                          "id": "ZXRwc",
                          "name": "Persistent underline",
                          "stroke": "$ink",
                          "strokeWidth": {
                            "bottom": 1
                          },
                          "children": [
                            {
                              "type": "text",
                              "id": "dByST",
                              "name": "Open the meditation timer",
                              "fill": "$ink",
                              "content": "Open the meditation timer",
                              "lineHeight": 1.4,
                              "fontFamily": "$sans",
                              "fontSize": 17,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "D93LL",
                  "name": "Section · Begin with fewer bells",
                  "context": "section",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "GoK1Q",
                      "name": "H2 · Begin with fewer bells",
                      "context": "h2",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Begin with fewer bells",
                      "lineHeight": 1.25,
                      "fontFamily": "$sans",
                      "fontSize": 24,
                      "fontWeight": "600",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "nSJE9",
                      "name": "Paragraph 1",
                      "context": "p",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "A meditation timer with interval bells lets you choose when sound interrupts the silence. You can use a bell as a quiet marker, or leave the whole session silent until the end. There is no need to follow every available cue. Start with the simplest arrangement you will actually use.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "dV65F",
                      "name": "Paragraph 2",
                      "context": "p",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "If you are beginning, choose a 10-minute session with one end bell. Turn interval bells off, leave the start bell off, and keep the end bell on. Press Start when you are ready. You do not need a sound at the beginning to know that the timer has started.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "wBKkr",
                  "name": "Section · What the default means",
                  "context": "section",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "De5sV",
                      "name": "H2 · What the default means",
                      "context": "h2",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "What the default means",
                      "lineHeight": 1.25,
                      "fontFamily": "$sans",
                      "fontSize": 24,
                      "fontWeight": "600",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "Fse4u",
                      "name": "Paragraph 1",
                      "context": "p",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The default session is 30 minutes long, with an interval every 10 minutes. That gives you interval bells at 10 and 20 minutes. The bell at 30 minutes is the optional end bell, not another interval cue. By default, the start bell is off and the end bell is on.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "rjnR8",
                      "name": "Paragraph 2",
                      "context": "p",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Think of the interval setting as the space between markers, not the length of the session. With these defaults, you have three stretches of silence. You can stay with the same practice throughout, or use the two interval bells to mark a change without checking the remaining time.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "Jv3lV",
                  "name": "Section · Choose each sound separately",
                  "context": "section",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "oc0Lq",
                      "name": "H2 · Choose each sound separately",
                      "context": "h2",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Choose each sound separately",
                      "lineHeight": 1.25,
                      "fontFamily": "$sans",
                      "fontSize": 24,
                      "fontWeight": "600",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "oU0pL",
                      "name": "Paragraph 1",
                      "context": "p",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Interval bells, the start bell, and the end bell are independent options. You can keep the interval bells and turn off the end bell, or switch off intervals and use only an end bell. Add a start bell if an audible opening is useful. None of those choices requires the others to be on.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "WkqcK",
                      "name": "Paragraph 2",
                      "context": "p",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Global mute silences all bells, including any start or end bell you have selected. If you want a completely silent timer, use mute. If you want just one sound, leave mute off and disable the individual cues you do not want. Before settling in, check the device volume as well as the timer settings.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "w4lcz",
                  "name": "Section · Give the markers a purpose",
                  "context": "section",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "avXto",
                      "name": "H2 · Give the markers a purpose",
                      "context": "h2",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Give the markers a purpose",
                      "lineHeight": 1.25,
                      "fontFamily": "$sans",
                      "fontSize": 24,
                      "fontWeight": "600",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "CZmoq",
                      "name": "Paragraph 1",
                      "context": "p",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "You might spend the first 10 minutes sitting, the next 10 walking slowly, and the final 10 sitting again. Or let each bell be a simple reminder to notice what you are doing. Decide beforehand so the sound does not become another decision to make during the session.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "WGlTT",
                      "name": "Paragraph 2",
                      "context": "p",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "If the bells feel too frequent, increase the interval or turn intervals off. A short session does not need to be divided into smaller parts. The timer is there to hold the time you chose, not to make you complete a sequence. You can pause or stop whenever you need to.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "wbgV4",
                  "name": "Section · Keep the timer available",
                  "context": "section",
                  "width": "fill_container",
                  "layout": "vertical",
                  "gap": 16,
                  "children": [
                    {
                      "type": "text",
                      "id": "DlOip",
                      "name": "H2 · Keep the timer available",
                      "context": "h2",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Keep the timer available",
                      "lineHeight": 1.25,
                      "fontFamily": "$sans",
                      "fontSize": 24,
                      "fontWeight": "600",
                      "letterSpacing": -0.4
                    },
                    {
                      "type": "text",
                      "id": "LQonZ",
                      "name": "Paragraph 1",
                      "context": "p",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Keep the timer tab open for the session. After a cached visit, the timer can work offline; open it once while connected before relying on it somewhere without a connection. For an unfamiliar device, try a short session first so you know what the bell sounds like at your chosen volume.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "text",
                      "id": "H6lq2V",
                      "name": "Paragraph 2",
                      "context": "p",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Background audio is not guaranteed. Browsers and phones can suspend a tab or restrict sound when you switch apps or lock the screen. If hearing the bell matters, keep the page visible rather than assuming it will sound in the background. A timer in an open tab is not a guaranteed alarm.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "F9R2a",
                  "name": "Alternative and Try it",
                  "width": "fill_container",
                  "stroke": "$line",
                  "strokeWidth": {
                    "top": 1
                  },
                  "layout": "vertical",
                  "gap": 12,
                  "padding": [
                    24,
                    0,
                    0,
                    0
                  ],
                  "children": [
                    {
                      "type": "text",
                      "id": "urrNs",
                      "name": "Work and rest alternative",
                      "context": "p",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Need alternating work and rest periods instead of markers within one session? Use the interval timer. It is a different setup for repeating two phases.",
                      "lineHeight": 1.65,
                      "fontFamily": "$sans",
                      "fontSize": 17,
                      "fontWeight": "normal"
                    },
                    {
                      "type": "frame",
                      "id": "nqGzb",
                      "name": "Link target · Interval timer for work and rest",
                      "height": 44,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "frame",
                          "id": "kIRFM",
                          "name": "Persistent underline",
                          "stroke": "$ink",
                          "strokeWidth": {
                            "bottom": 1
                          },
                          "children": [
                            {
                              "type": "text",
