# Removed timers. Specific rules first; Cloudflare Pages evaluates top to bottom.
# An old /timer/<length> countdown goes to a preset only when that preset is a
# single session ending at the same length; repeating presets would keep running.
/stopwatch                                  /interval     301
/timer                                      /interval     301
/timer/meditation-timer                     /meditation   301
/timer/nap-timer                            /meditation   301
/timer/study-timer                          /pomodoro     301
/timer/25-minutes                           /pomodoro     301
/timer/5-minutes                            /meditation/5-minutes   301
/timer/10-minutes                           /meditation/10-minutes  301
/timer/*                                    /interval     301
/blog/meditation-timer-with-interval-bells  /blog/meditation-timer-interval-bells  301
